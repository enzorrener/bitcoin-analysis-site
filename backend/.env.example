# Configurações do Servidor
PORT=5000
NODE_ENV=development

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitcoin_analysis
DB_USER=postgres
DB_PASSWORD=your_password_here

# APIs Externas
BINANCE_API_URL=https://api.binance.com/api/v3
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Opcional: chave gratuita (Demo) da CoinGecko para limites maiores
COINGECKO_API_KEY=

# CORS - Frontend URL (aceita várias separadas por vírgula)
FRONTEND_URL=http://localhost:3000,http://localhost:4173

# Autenticação (troque por um valor longo e aleatório)
JWT_SECRET=troque_por_uma_chave_secreta_longa
JWT_EXPIRES_IN=7d

# Rotina de notícias (09:00 e 18:00, horário de Brasília)
NEWS_JOB_ENABLED=true

# Cache (em segundos)
CACHE_TTL_PRICE=30
CACHE_TTL_HISTORY=300
